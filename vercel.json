{
  "version": 2,
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{seed_db.sqlite3,templates/**}"
    },
    "config/wsgi.py": {
      "includeFiles": "{seed_db.sqlite3,templates/**}"
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
